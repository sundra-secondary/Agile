{
  "info": {
    "name": "E-Pharmacist Account - Practical 5",
    "description": "Import this Postman 2.1 collection into Thunder Client. Run Sign up or Log in first. Copy token and user.id from the JSON response into the token and userId collection variables for protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4001" },
    { "key": "userId", "value": "PASTE_CREATED_USER_ID" },
    { "key": "token", "value": "PASTE_JWT_TOKEN" }
  ],
  "item": [
    {
      "name": "Sign up",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Karma\",\n  \"lastName\": \"Wangmo\",\n  \"email\": \"karma@example.com\",\n  \"role\": \"patient\",\n  \"password\": \"pass1234\",\n  \"passwordConfirm\": \"pass1234\"\n}" },
        "url": "{{baseUrl}}/api/v1/users/signup"
      }
    },
    {
      "name": "Log in",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"karma@example.com\",\n  \"password\": \"pass1234\"\n}" },
        "url": "{{baseUrl}}/api/v1/users/login"
      }
    },
    { "name": "Get all users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/users" } },
    { "name": "Get user", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}" } },
    {
      "name": "Update user and password",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Karma Updated\",\n  \"password\": \"newpass1234\",\n  \"passwordConfirm\": \"newpass1234\"\n}" },
        "url": "{{baseUrl}}/api/v1/users/{{userId}}"
      }
    },
    { "name": "Delete user", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}" } }
  ]
}
