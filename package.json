{
  "name": "epharmacist-signup",
  "version": "1.0.0",
  "private": true,
  "description": "CSF202 E-Pharmacist accounts and news feeds",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/account.test.js && jest --config tests/jest.config.js --runInBand",
    "test:unit": "jest --config tests/jest.config.js --runInBand tests/unit",
    "test:acceptance": "jest --config tests/jest.config.js --runInBand tests/integration",
    "test:coverage": "jest --config tests/jest.config.js --coverage --runInBand",
    "test:integration": "node test/integration.test.js",
    "test:atlas": "node test/integration.test.js --atlas",
    "seed:sme": "node scripts/seed-sme.js"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "multer": "^2.5.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.4"
  }
}
