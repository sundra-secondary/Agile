<%- include('partials/head') %>
<main class="profile-shell">
  <div class="profile-heading">
    <a class="text-link" href="/dashboard">← Dashboard</a>
    <p class="eyebrow">MY PROFILE</p>
    <h1>Account settings</h1>
    <p>Update your details, photo, or password.</p>
  </div>
  <section class="profile-card" aria-labelledby="details-heading">
    <h2 id="details-heading">Personal details</h2>
    <form data-profile-form enctype="multipart/form-data">
      <div class="profile-photo-row">
        <% if (user.photo) { %><img class="profile-photo" data-profile-photo src="<%= user.photo %>" alt="Profile photo"><% } else { %><span class="profile-photo profile-photo-fallback" data-profile-photo aria-label="No profile photo"><%= user.firstName.charAt(0).toUpperCase() %></span><% } %>
        <label>Profile photo<input type="file" name="photo" accept="image/png,image/jpeg,image/webp"><small>JPEG, PNG, or WebP. Maximum 2 MB.</small></label>
      </div>
      <div class="form-row"><label>First name<input name="firstName" value="<%= user.firstName %>" maxlength="60" required></label><label>Last name<input name="lastName" value="<%= user.lastName %>" maxlength="60" required></label></div>
      <label>Email address<input type="email" name="email" value="<%= user.email %>" required></label>
      <p class="profile-role">Account type: <strong><%= user.role %></strong></p>
      <button class="primary-button" type="submit">Save details</button>
    </form>
  </section>
  <section class="profile-card" aria-labelledby="password-heading">
    <h2 id="password-heading">Change password</h2>
    <form data-password-form>
      <label>Current password<input type="password" name="passwordCurrent" autocomplete="current-password" required></label>
      <label>New password<input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
      <label>Confirm new password<input type="password" name="passwordConfirm" autocomplete="new-password" minlength="8" required></label>
      <button class="primary-button" type="submit">Save password</button>
    </form>
  </section>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.20.0/axios.min.js" defer></script>
<script src="/js/alert.js" defer></script>
<script src="/js/profile.js" defer></script>
<%- include('partials/foot') %>
