<%- include('partials/head') %>
<main class="page-shell">
  <section class="intro-panel">
    <div class="intro-content">
      <p class="eyebrow">WELCOME TO EPHARMACIST</p>
      <h1>Good care starts with a simple step.</h1>
      <p class="intro-copy">Create an account to keep your care journey organized, whether you’re managing your own health or helping someone you love.</p>
      <div class="feature-list">
        <div class="feature"><span class="feature-icon">01</span><span>One place for your health information</span></div>
        <div class="feature"><span class="feature-icon">02</span><span>Support for patients and caregivers</span></div>
        <div class="feature"><span class="feature-icon">03</span><span>Private account access</span></div>
      </div>
    </div>
    <div class="decorative-orbit" aria-hidden="true"><div class="orbit-inner">✚</div></div>
    <p class="intro-bottom">Made for better everyday care.</p>
  </section>
  <section class="form-panel">
    <div class="form-inner">
      <div class="step-note">ACCOUNT SETUP <span>01 / 01</span></div>
      <h2>Create your account</h2>
      <p class="subheading">Already have an account? <a href="/login">Sign in</a></p>
      <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
      <form action="/signup" method="post" data-validate>
        <fieldset class="role-picker">
          <legend>I’m signing up as a</legend>
          <label class="role-option"><input type="radio" name="role" value="patient" <%= values.role === 'patient' ? 'checked' : '' %> required><span><strong>Patient</strong><small>Manage my own care</small></span></label>
          <label class="role-option"><input type="radio" name="role" value="caregiver" <%= values.role === 'caregiver' ? 'checked' : '' %> required><span><strong>Caregiver</strong><small>Support someone else</small></span></label>
        </fieldset>
        <div class="form-row">
          <label>First name<input name="firstName" autocomplete="given-name" value="<%= values.firstName || '' %>" maxlength="60" required></label>
          <label>Last name<input name="lastName" autocomplete="family-name" value="<%= values.lastName || '' %>" maxlength="60" required></label>
        </div>
        <label>Email address<input type="email" name="email" autocomplete="email" placeholder="you@example.com" value="<%= values.email || '' %>" required></label>
        <label>Password<input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
        <p class="field-help">At least 8 characters.</p>
        <label>Confirm password<input type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required></label>
        <p class="field-error" data-password-error role="alert" hidden>Passwords do not match.</p>
        <button class="primary-button" type="submit">Create account <span aria-hidden="true">→</span></button>
      </form>
      <p class="privacy-note">Your password is stored as a secure hash, never in plain text.</p>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
