<%- include('partials/head') %>
<main class="single-page" data-dashboard data-authenticated="<%= user ? 'true' : 'false' %>" data-user-id="<%= user ? user.id : '' %>" data-first-name="<%= user ? user.firstName : '' %>" data-role="<%= user ? user.role : '' %>">
  <div class="dashboard-card">
    <% if (user) { %>
      <p class="eyebrow">YOUR ACCOUNT</p>
      <h1>Welcome, <%= user.firstName %>.</h1>
      <p>You are signed in as a <strong><%= user.role %></strong>.</p>
      <p class="muted">Your account has been created. More ePharmacist services will be added in later sprints.</p>
      <a class="text-link" href="/me">Manage my profile</a>
      <form action="/logout" method="post" data-logout>
        <button class="primary-button" type="submit">Sign out <span aria-hidden="true">→</span></button>
      </form>
    <% } else { %>
      <p class="eyebrow">WELCOME TO EPHARMACIST</p>
      <h1>Your care starts here.</h1>
      <p class="muted">Sign in to see your account, or create one if you are new.</p>
      <a class="primary-button button-link" href="/login">Sign in <span aria-hidden="true">→</span></a>
      <p class="dashboard-secondary">New here? <a class="text-link" href="/signup">Create an account</a></p>
    <% } %>
  </div>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.20.0/axios.min.js" defer></script>
<script src="/js/alert.js" defer></script>
<script src="/js/dashboard.js" defer></script>
<%- include('partials/foot') %>
