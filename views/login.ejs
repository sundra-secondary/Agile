<%- include('partials/head') %>
<main class="page-shell">
  <section class="intro-panel">
    <div class="intro-content">
      <p class="eyebrow">WELCOME BACK</p>
      <h1>Your care is right where you left it.</h1>
      <p class="intro-copy">Sign in to your ePharmacist account and continue your health journey.</p>
    </div>
    <div class="decorative-orbit" aria-hidden="true"><div class="orbit-inner">✚</div></div>
    <p class="intro-bottom">Made for better everyday care.</p>
  </section>
  <section class="form-panel">
    <div class="form-inner login-inner">
      <div class="step-note">ACCOUNT ACCESS <span>WELCOME BACK</span></div>
      <h2>Sign in</h2>
      <p class="subheading">New to ePharmacist? <a href="/signup">Create an account</a></p>
      <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
      <form action="/login" method="post">
        <label>Email address<input type="email" name="email" autocomplete="email" placeholder="you@example.com" value="<%= email %>" required></label>
        <label>Password<input type="password" name="password" autocomplete="current-password" required></label>
        <button class="primary-button" type="submit">Sign in <span aria-hidden="true">→</span></button>
      </form>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
