PORT=4001
DATABASE_LOCAL=mongodb://127.0.0.1:27017/epharmacist
# To use MongoDB Atlas, set DATABASE_URL to your full connection URI.
# DATABASE_URL=mongodb+srv://username:password@cluster.example.mongodb.net/epharmacist
# For the integration test, use a separate Atlas database if needed.
# TEST_DATABASE_URL=mongodb+srv://username:password@cluster.example.mongodb.net/epharmacist_integration
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
NODE_ENV=development
